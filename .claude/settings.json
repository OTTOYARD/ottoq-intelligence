{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "//": "WHY THIS FILE EXISTS, 2026-09-21. This repo had no .claude/ directory at all, so a session whose working directory was ottoq-intelligence read only the user-level settings -- which live in an EPHEMERAL container and are lost when it is reclaimed -- and prompted for approval on essentially every tool call. otto-q-core has carried an allowlist since 2026-09-14 and this repo carried nothing, which is why the prompts followed the working directory rather than the task. defaultMode is the setting Chase asked for three times; the allowlist below is kept alongside it so removing the blanket mode still leaves this repo workable.",

  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "mcp__github__get_me",
      "mcp__github__get_commit",
      "mcp__github__get_file_contents",
      "mcp__github__list_commits",
      "mcp__github__list_branches",
      "mcp__github__list_pull_requests",
      "mcp__github__pull_request_read",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__update_pull_request_branch",
      "mcp__github__add_issue_comment",
      "mcp__github__add_reply_to_pull_request_comment",
      "mcp__github__pull_request_review_write",
      "mcp__github__add_comment_to_pending_review",
      "mcp__github__resolve_review_thread",
      "mcp__github__get_check_run",
      "mcp__github__get_job_logs",
      "mcp__github__actions_list",
      "mcp__github__actions_run_trigger",
      "mcp__github__search_code",
      "mcp__github__search_pull_requests",
      "mcp__github__subscribe_pr_activity",
      "mcp__github__unsubscribe_pr_activity",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git merge:*)",
      "Bash(git restore:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(pip:*)",
      "Bash(pytest:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(docker:*)",
      "Bash(aws:*)",
      "Bash(curl:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(chmod:*)",
      "Bash(find:*)",
      "Bash(diff:*)",
      "Bash(sha256sum:*)",
      "Bash(which:*)",
      "Bash(env:*)"
    ]
  },

  "skipDangerousModePermissionPrompt": true
}
